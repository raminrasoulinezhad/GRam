# Credentials for the artwork pipeline. Copy to .env and fill in what you need.
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. This file is the template and holds no
# values. The npm scripts load .env automatically, so nothing needs exporting by hand.
#
# Only the keys for the path you are running are required. GEMINI_API_KEY is the exception:
# every path uses it, because spec writing and scoring run on Gemini's free text and vision
# tier whichever provider renders the pixels.

# ---- always needed, free ------------------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- path 1: Cloudflare Workers AI, FLUX.1-schnell, free ------------------------------------
# Account id: dash.cloudflare.com, right-hand sidebar.
# Token: Profile > API tokens > Create, "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---- path 2: Hugging Face router, FLUX.1-schnell, small monthly credit ----------------------
# https://huggingface.co/settings/tokens, read scope is enough.
# No longer a free tier: Hugging Face forwards text-to-image to nscale/fal-ai/wavespeed and
# bills an account credit worth about $0.10 a month on a free plan, so a few dozen images.
HF_TOKEN=

# ---- path 3: your own machine, FLUX.1-schnell, free -----------------------------------------
# Not a key. The address of a local server you run that takes {"prompt": "..."}.
LOCAL_IMAGE_URL=

# ---- path 4: fal.ai, FLUX.1-dev, paid --------------------------------------------------------
# https://fal.ai/dashboard/keys   About $45 for the whole catalog at 768px.
FAL_KEY=

# ---- path 5: Replicate, FLUX.1-dev, paid -----------------------------------------------------
# https://replicate.com/account/api-tokens   About $54 for the whole catalog.
REPLICATE_API_TOKEN=

# ---- optional overrides ----------------------------------------------------------------------
# GEMINI_TEXT_MODEL=gemini-3.6-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# HF_PROVIDER=nscale            # or fal-ai, or wavespeed
